#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

import vc_git_builders

env_vc_git = env_modules.Clone()

# The GDScript sources (scripts/) are compressed into the editor binary.
scripts_dir = Dir("scripts").srcnode().abspath
env_vc_git.CommandNoCache(
    "vc_git_scripts.gen.h",
    vc_git_builders.script_sources(scripts_dir),  # The first one is a file at the root of scripts/.
    env.Run(vc_git_builders.make_scripts_header),
)

env_vc_git.add_source_files(env.modules_sources, "*.cpp")
